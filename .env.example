# Optional: Official Social Blade Business Matrix API credentials (Tier 1)
# Sign up at https://socialblade.com/business-api
SOCIALBLADE_CLIENT_ID=
SOCIALBLADE_TOKEN=

# Optional: Browser Backend for Zero-Cost Next.js + tRPC Extraction (Tier 2)
# Choices: auto (default) | playwright | cdp | ego
SOCIALBLADE_BROWSER_BACKEND=auto

# Optional: Chrome DevTools Protocol (CDP) endpoint when using SOCIALBLADE_BROWSER_BACKEND=cdp
# Example: http://127.0.0.1:9222
SOCIALBLADE_CDP_URL=

# Optional: Playwright channel & headless override (headed Chrome passes Cloudflare Turnstile)
SOCIALBLADE_BROWSER_CHANNEL=chrome
SOCIALBLADE_BROWSER_HEADLESS=0

# Optional: TikHub API key for Twitter/X Bridge (Tier 3 — bridges Social Blade's discontinued Twitter support)
TIKHUB_API_KEY=

# Optional: Custom SQLite SSOT snapshot database path
# Default: ~/.local/share/socialblade-cli/snapshots.db
SOCIALBLADE_DB_PATH=
